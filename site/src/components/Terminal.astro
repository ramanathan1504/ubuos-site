---
/**
 * A terminal that types itself out.
 *
 * Every line below is real output, copied from a run — not mocked. A demo that
 * shows output the tool does not produce is a promise you have to keep later,
 * and the first person to run the command finds out you did not.
 *
 * It renders fully formed and static first, then animates. A visitor who arrives
 * with JavaScript disabled, or before it loads, sees the finished session rather
 * than an empty box — the frame that matters most is the first one.
 */
---

<div class="term" id="term">
  <div class="tbar">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <span class="who">oss — your terminal</span>
  </div>
  <pre class="body"><code id="termbody"></code></pre>
</div>

<script is:inline>
  (() => {
    const scenes = [
      [
        ['cmd', 'oss search "rollover compression" --global'],
        ['dim', 'Model server unreachable. Falling back to text search.'],
        ['dim', 'No embeddings found — searching 17845 item(s) by text instead.'],
        ['out', '1. [quarkusio/quarkus_46498]        HTTP compression min size          0.53'],
        ['out', '2. [opensearch-project/OpenSearch]  Support different compression types 0.53'],
        ['out', '3. [elastic/elasticsearch_115210]   Add selector support in rollover    0.53'],
        ['ok',  'no model, no server — 17,845 issues searched'],
      ],
      [
        ['cmd', 'oss followup'],
        ['out', 'apache/logging-log4j2            #4234  blocked  katstack        —'],
        ['out', 'ramanathan1504/knowledge-creator #1     take     ramanathan1504  merged'],
        ['ok',  'every project you follow, in one list'],
      ],
      [
        ['cmd', 'oss ext add ~/my-kafka-bench'],
        ['out', 'registered kafka (runner) — 2 verbs: list, run'],
        ['cmd', 'oss run --name kafka run payments'],
        ['out', 'producing to payments against localhost:9092 …'],
        ['ok',  'anyone attaches their own repo — one JSON file'],
      ],
    ];

    const el = document.getElementById('termbody');
    if (!el) return;

    // Render the last scene immediately, so there is never an empty terminal.
    const paint = (lines, upto, partial) => {
      let html = '';
      lines.slice(0, upto).forEach(([k, t]) => {
        html += k === 'cmd' ? `<span class="p">$</span> <span class="c">${t}</span>\n`
              : k === 'ok'  ? `<span class="k">✓ ${t}</span>\n`
              : k === 'dim' ? `<span class="d">${t}</span>\n`
              : `${t}\n`;
      });
      if (partial != null) {
        const [k, t] = lines[upto];
        html += k === 'cmd' ? `<span class="p">$</span> <span class="c">${t.slice(0, partial)}</span><span class="cur">▋</span>\n` : '';
      }
      el.innerHTML = html;
    };
    paint(scenes[0], scenes[0].length, null);

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let scene = 0;
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));

    async function run() {
      // Hold the finished session on screen before animating. Without this the
      // loop clears it on the first tick, so the first thing anyone sees -- and
      // the only thing a screenshot catches -- is an empty box.
      await wait(1600);
      while (true) {
        const lines = scenes[scene];
        el.innerHTML = '';
        for (let i = 0; i < lines.length; i++) {
          if (lines[i][0] === 'cmd') {
            // Typed, because that is the part a person does. Output arrives whole,
            // because that is how output arrives.
            for (let c = 0; c <= lines[i][1].length; c++) {
              paint(lines, i, c);
              await wait(28);
            }
            await wait(320);
          }
          paint(lines, i + 1, null);
          await wait(lines[i][0] === 'ok' ? 1500 : 260);
        }
        await wait(2600);
        scene = (scene + 1) % scenes.length;
      }
    }
    run();
  })();
</script>

<style>
  .term {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    overflow: hidden;
    box-shadow: 0 18px 50px -28px rgba(0, 0, 0, 0.45);
  }
  .tbar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--code) 70%, transparent);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .r { background: #ec6a5e; } .y { background: #f4bf4f; } .g { background: #61c554; }
  .tbar .who { margin-left: 8px; font-size: 12px; color: var(--muted); }
  .body {
    margin: 0;
    padding: 16px 18px;
    background: transparent;
    border: 0;
    /* Fixed height so the page does not jump as scenes change length — layout
       shifting under a reader is worse than a little empty space. */
    min-height: 232px;
    font-size: 13px;
    line-height: 1.62;
    overflow-x: auto;
  }
  .body :global(.p) { color: var(--accent); }
  .body :global(.c) { color: var(--fg); font-weight: 500; }
  .body :global(.d) { color: var(--muted); }
  .body :global(.k) { color: var(--ok); }
  .body :global(.cur) { animation: blink 1s steps(2) infinite; color: var(--accent); }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 640px) { .body { font-size: 11.5px; min-height: 250px; } }
</style>