---
/**
 * One layout for every page.
 *
 * The palette is defined once, in tokens, and the dark variant only re-states
 * the tokens — never the rules. A stylesheet that repeats its layout inside a
 * media query drifts the moment one copy is edited, and the drift shows up only
 * in the theme nobody is currently looking at.
 */
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="bar">
      <a class="wordmark" href="/">ubuos</a>
      <nav>
        <a href="/#tools">Tools</a>
        <a href="/extensions">Extensions</a>
        <a href="https://docs.ubuos.com">Docs</a>
        <a href="https://github.com/ramanathan1504" class="ghost">GitHub</a>
        <button id="theme" class="theme" type="button" aria-label="Switch colour theme">◐</button>
      </nav>
    </header>

    <main><slot /></main>

    <footer>
      <p>Built for people who maintain things.</p>
      <p class="dim">Apache 2.0 · <a href="https://github.com/ramanathan1504">github.com/ramanathan1504</a></p>
    </footer>

    <script is:inline>
      // Inline and before paint: a toggle applied after render flashes the wrong
      // theme for a frame, which is the one bug people actually notice.
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
        addEventListener('DOMContentLoaded', () => {
          const btn = document.getElementById('theme');
          if (!btn) return;
          btn.addEventListener('click', () => {
            const root = document.documentElement;
            // No stored choice yet means we are following the system, so the first
            // click has to flip away from what the system currently says -- not
            // from a default we assumed.
            const current =
              root.dataset.theme ||
              (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            const next = current === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            localStorage.setItem('theme', next);
          });
        });
      })();
    </script>

    <style is:global>
      :root {
        --bg: #fbfaf8;
        --fg: #16150f;
        --muted: #6b675e;
        --line: #e6e1d7;
        --card: #ffffff;
        --accent: #9a5b25;
        --code: #f2efe8;
        --ok: #2f6f43;
        --radius: 14px;
        --measure: 68ch;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #100f0d;
          --fg: #eee9df;
          --muted: #9b958a;
          --line: #262320;
          --card: #17161300;
          --card: #171613;
          --accent: #e0a267;
          --code: #1e1c18;
          --ok: #7fb08c;
        }
      }
      :root[data-theme='light'] {
        --bg: #fbfaf8;
        --fg: #16150f;
        --muted: #6b675e;
        --line: #e6e1d7;
        --card: #ffffff;
        --accent: #9a5b25;
        --code: #f2efe8;
        --ok: #2f6f43;
      }
      :root[data-theme='dark'] {
        --bg: #100f0d;
        --fg: #eee9df;
        --muted: #9b958a;
        --line: #262320;
        --card: #171613;
        --accent: #e0a267;
        --code: #1e1c18;
        --ok: #7fb08c;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 17px/1.65 ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }

      .bar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 24px; padding: 20px clamp(20px, 6vw, 64px);
        border-bottom: 1px solid var(--line);
        position: sticky; top: 0; z-index: 10;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(180%) blur(12px);
      }
      .wordmark { font-weight: 650; letter-spacing: -0.02em; text-decoration: none; font-size: 18px; }
      .bar nav { display: flex; gap: 22px; font-size: 15px; }
      .bar nav a { color: var(--muted); text-decoration: none; }
      .bar nav a:hover { color: var(--fg); }
      .theme {
        background: none; border: 1px solid var(--line); color: var(--muted);
        border-radius: 8px; width: 30px; height: 28px; cursor: pointer; font-size: 14px;
        line-height: 1;
      }
      .theme:hover { color: var(--accent); border-color: var(--accent); }

      main { padding: 0 clamp(20px, 6vw, 64px); }
      section { max-width: 1080px; margin: 0 auto; padding: clamp(34px, 5vw, 62px) 0; }

      h1 {
        font-size: clamp(34px, 5.4vw, 56px); line-height: 1.06;
        letter-spacing: -0.035em; font-weight: 660; margin: 0 0 16px;
      }
      h2 { font-size: clamp(22px, 2.6vw, 29px); letter-spacing: -0.02em; margin: 0 0 8px; }
      h3 { font-size: 19px; margin: 0 0 6px; letter-spacing: -0.01em; }
      .lede { font-size: clamp(18px, 2.1vw, 22px); color: var(--muted); max-width: var(--measure); margin: 0; }
      .dim { color: var(--muted); }

      .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-top: 32px; }
      .card {
        border: 1px solid var(--line); border-radius: var(--radius);
        background: var(--card); padding: 17px 19px;
        transition: border-color .15s ease, transform .15s ease;
      }
      .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); transform: translateY(-2px); }
      .card p { color: var(--muted); margin: 0; }

      .pill {
        display: inline-block; font-size: 11.5px; letter-spacing: .07em;
        text-transform: uppercase; color: var(--accent);
        border: 1px solid var(--line); border-radius: 20px; padding: 2px 10px;
      }

      pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      pre {
        background: var(--code); border: 1px solid var(--line); border-radius: 10px;
        padding: 14px 16px; overflow-x: auto; font-size: 14px; margin: 0;
      }
      code { font-size: .93em; }
      p code { background: var(--code); padding: 1px 6px; border-radius: 5px; }

      footer {
        border-top: 1px solid var(--line); margin-top: 24px;
        padding: 26px clamp(20px, 6vw, 64px); font-size: 14px;
      }
      footer p { margin: 0 0 4px; }
    </style>
  </body>
</html>
